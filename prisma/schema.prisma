generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MemberRole {
  ADMIN
  AGENT
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  PENDING
  RESOLVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum FieldType {
  TEXT
  EMAIL
  PHONE
  SELECT
  DESCRIPTION
  ATTACHMENT
}

enum MessageOrigin {
  USER
  AGENT
  EMAIL
  SYSTEM
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents  Agent[]
  areas   Area[]
  desks   Desk[]
  plan    PlanLimit?
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requested   Ticket[]             @relation("RequestedTickets")
  messages    Message[]
  events      TicketEvent[]
}

model Agent {
  id             String   @id @default(uuid()) @db.Uuid
  authUserId     String?  @unique @map("auth_user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  email          String
  role           MemberRole @default(AGENT)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  areas        AgentArea[]
  assigned     Ticket[] @relation("AssignedTickets")

  @@index([organizationId, active])
}

model Area {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  color          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents       AgentArea[]

  @@unique([organizationId, name])
}

model AgentArea {
  agentId   String   @map("agent_id") @db.Uuid
  areaId    String   @map("area_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  area  Area  @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([agentId, areaId])
  @@index([areaId])
}

model Desk {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  slug           String       @unique
  description    String?
  logoUrl        String?      @map("logo_url")
  coverUrl       String?      @map("cover_url")
  isOpen         Boolean      @default(true)
  isPublic       Boolean      @default(true) @map("is_public")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories   Category[]
  tickets      Ticket[]

  @@index([organizationId])
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  deskId      String   @db.Uuid
  name        String
  description String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  desk     Desk     @relation(fields: [deskId], references: [id], onDelete: Cascade)
  form     Form?
  tickets  Ticket[]

  @@index([deskId, active, position])
}

model Form {
  id         String     @id @default(uuid()) @db.Uuid
  categoryId String     @unique @db.Uuid
  version    Int        @default(1)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  category Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fields   FormField[]
}

model FormField {
  id          String   @id @default(uuid()) @db.Uuid
  formId      String   @db.Uuid
  key         String
  label       String
  type        FieldType
  required    Boolean  @default(false)
  options     Json?
  position    Int      @default(0)
  allowFiles  Boolean  @default(false)

  form       Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  values     TicketFieldValue[]

  @@unique([formId, key])
  @@index([formId, position])
}

model Ticket {
  id           String         @id @default(uuid()) @db.Uuid
  publicNumber String         @unique
  deskId       String         @db.Uuid
  categoryId   String         @db.Uuid
  requesterId  String?        @db.Uuid
  assignedToId String?        @map("assigned_to_id") @db.Uuid
  requesterName  String?
  requesterEmail String?
  status       TicketStatus   @default(NEW)
  priority     TicketPriority @default(NORMAL)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  resolvedAt   DateTime?
  deletedAt    DateTime?

  desk        Desk              @relation(fields: [deskId], references: [id])
  category    Category          @relation(fields: [categoryId], references: [id])
  requester   User?             @relation("RequestedTickets", fields: [requesterId], references: [id])
  assignedTo  Agent?            @relation("AssignedTickets", fields: [assignedToId], references: [id])
  fieldValues TicketFieldValue[]
  messages    Message[]
  attachments Attachment[]
  events      TicketEvent[]
  emailThread EmailThread?

  @@index([deskId, status, updatedAt])
  @@index([assignedToId, status])
}

model TicketFieldValue {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  fieldId   String   @db.Uuid
  value     Json

  ticket Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  field  FormField @relation(fields: [fieldId], references: [id])

  @@unique([ticketId, fieldId])
}

model Message {
  id          String        @id @default(uuid()) @db.Uuid
  ticketId    String        @db.Uuid
  authorId    String?       @db.Uuid
  origin      MessageOrigin
  body        String
  externalId  String?
  createdAt   DateTime      @default(now())

  ticket Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?        @relation(fields: [authorId], references: [id])
  files  Attachment[]

  @@unique([externalId])
  @@index([ticketId, createdAt])
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @db.Uuid
  messageId    String?  @db.Uuid
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  createdAt    DateTime @default(now())

  ticket  Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model TicketEvent {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  actorId    String?  @db.Uuid
  eventType  String
  fromValue  String?
  toValue    String?
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
}

model EmailThread {
  id                String   @id @default(uuid()) @db.Uuid
  ticketId          String   @unique @db.Uuid
  providerThreadId  String   @unique
  replyToAddress    String   @unique
  createdAt         DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model PlanLimit {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @db.Uuid
  planCode       String       @default("free")
  maxDesks       Int          @default(1)
  maxCategories Int          @default(4)
  maxAgents      Int          @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
